parameters:
	ignoreErrors:
		-
			identifier: trait.unused

		-
			identifier: staticMethod.internalClass

		-
			identifier: method.internal

		-
			identifier: method.internalClass

		-
			identifier: classConstant.internalClass

		-
			message: '#^Parameter \#1 \$string of function Psl\\Str\\trim expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Command/TestStubCreateCommand.php

		-
			message: '#^Unable to resolve the template type T in call to function Psl\\Regex\\first_match$#'
			identifier: argument.templateType
			count: 1
			path: src/Command/TestStubCreateCommand.php

		-
			message: '#^Variable property access on object\.$#'
			identifier: property.dynamicName
			count: 3
			path: src/SnapshotUpdater/Driver/Json.php

		-
			message: '#^Class Doctrine\\Bundle\\FixturesBundle\\Loader\\SymfonyFixturesLoader constructor invoked with 0 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Test/KernelTestCase.php

		-
			message: '#^Method Speicher210\\FunctionalTestBundle\\Test\\KernelTestCase\:\:getPayloadFromPhpFile\(\) should return array\<mixed\> but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: src/Test/KernelTestCase.php

		-
			message: '#^Only iterables can be unpacked, mixed given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: src/Test/KernelTestCase.php

		-
			message: '#^Parameter \#1 \.\.\.\$classNames of method Speicher210\\FunctionalTestBundle\\Test\\KernelTestCase\:\:loadFixtures\(\) expects class\-string\<Doctrine\\Common\\DataFixtures\\FixtureInterface\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Test/KernelTestCase.php

		-
			message: '#^Class Doctrine\\Bundle\\FixturesBundle\\Loader\\SymfonyFixturesLoader does not have a constructor and must be instantiated without any parameters\.$#'
			identifier: new.noConstructor
			count: 1
			path: src/Test/KernelTestCase.php

		-
			rawMessage: 'Parameter #1 $reflection of method Speicher210\FunctionalTestBundle\Test\KernelTestCase::getFixturesFromTraits() expects ReflectionClass<object>, ReflectionObject<$this(Speicher210\FunctionalTestBundle\Test\KernelTestCase)> given.'
			identifier: argument.type
			count: 1
			path: src/Test/KernelTestCase.php

		-
			message: '#^Call to function method_exists\(\) with Doctrine\\ORM\\Configuration and ''enableNativeLazyObj…'' will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Test/Doctrine/ORM/Query/AST/FunctionTestCase.php

		-
			message: '#^Call to function method_exists\(\) with Doctrine\\ORM\\Configuration and ''enableNativeLazyObj…'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Test/Doctrine/ORM/Query/AST/FunctionTestCase.php
